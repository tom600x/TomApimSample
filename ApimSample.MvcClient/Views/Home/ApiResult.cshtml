@model ApimSample.MvcClient.Models.WeatherForecastViewModel

@{
    var apiTypeName = string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.ApiSource : Model.DisplayName;
    ViewData["Title"] = $"{apiTypeName} Weather Forecast";
    var colorClass = Model.ApiSource == "DirectAuth" ? "primary" : "success";
}

<div class="container">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">@apiTypeName</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card border-@colorClass mb-4">
        <div class="card-header bg-@colorClass text-white">
            <h2 class="mb-0">@apiTypeName Results</h2>
        </div>
        <div class="card-body">
            @if (Model.Success)
            {
                <h3 class="mb-4">Weather Forecast</h3>

                @if (Model.Forecasts.Any())
                {
                    <table class="table table-striped table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>Date</th>
                                <th>Temperature (C)</th>
                                <th>Temperature (F)</th>
                                <th>Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var forecast in Model.Forecasts)
                            {
                                <tr>
                                    <td>@forecast.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@forecast.TemperatureC</td>
                                    <td>@forecast.TemperatureF</td>
                                    <td>@forecast.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-warning">
                        <p>No forecast data available.</p>
                    </div>
                }
            }
            else if (Model.NotDeployed)
            {
                <div class="alert alert-warning">
                    <h4>Not deployed to Azure yet</h4>
                    <p>@Model.ErrorMessage</p>
                    <hr />
                    <p class="mb-0">
                        The <code>ApimSample.ApimSecuredApi</code> project exists in this solution but has not been
                        published to an App Service or imported into API Management, so there is no endpoint to call.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <h4>Error Fetching Data</h4>
                    <p>@Model.ErrorMessage</p>
                    <hr />
                    <h5>Possible causes:</h5>
                    <ul>
                        <li>The APIM subscription key (<code>ApiSettings:SubscriptionKey</code>) is missing or invalid</li>
                        <li>The client secret (<code>AzureAd:ClientSecret</code>) is missing or expired</li>
                        @if (Model.ApiSource == "DirectAuth")
                        {
                            <li>The <code>Api.Access</code> app role is not assigned to <code>ApimSample.Swagger</code></li>
                            <li>The token audience does not match the <code>ApimSample.Api</code> Application ID URI</li>
                            <li>The backend does not trust the APIM managed identity object ID</li>
                        }
                        else
                        {
                            <li>The OAuth policy in API Management is not correctly configured</li>
                            <li>The token is rejected by API Management</li>
                        }
                    </ul>
                </div>
            }
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">Back to Home</a>
        </div>
    </div>
    
    <div class="card mt-4">
        <div class="card-header">
            <h3 class="mb-0">How this works</h3>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.SecurityModel))
            {
                <p class="text-muted">@Model.SecurityModel</p>
            }
            @if (Model.ApiSource == "DirectAuth")
            {
                <h4>Zero-trust flow (App Roles + managed identity):</h4>
                <ol>
                    <li>This client acquires an app-only token from Microsoft Entra ID using the client credentials flow (<code>ApimSample.Swagger</code> → <code>api://&lt;ApimSample.Api&gt;/.default</code>)</li>
                    <li>The token carries the <code>Api.Access</code> app role in its <code>roles</code> claim</li>
                    <li>API Management validates the token's issuer, tenant, audience, signature and <code>Api.Access</code> role</li>
                    <li>API Management discards the caller's token and acquires a new one using its own managed identity</li>
                    <li>The backend validates that token and confirms the caller is API Management's managed identity</li>
                </ol>
                <div class="alert alert-info">
                    <strong>Key benefit:</strong> the backend trusts only API Management, so calls that bypass the gateway are rejected with 403 even when they present a valid Entra ID token.
                </div>
            }
            else
            {
                <h4>APIM-only authentication flow:</h4>
                <ol>
                    <li>The client sends a request with an OAuth token to API Management</li>
                    <li>API Management validates the token using an OAuth policy</li>
                    <li>If valid, API Management forwards the request to the API</li>
                    <li>The API (with no authentication code) processes the request</li>
                </ol>
                <div class="alert alert-info">
                    <strong>Key benefit:</strong> simplified API code with centralized security in API Management.
                </div>
            }
        </div>
    </div>
</div>
